# Copy to apps/mobile/.env. All EXPO_PUBLIC_* values are embedded in the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Native build configuration only. Restrict each Google Maps key to its app/SDK.
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Never put service_role, secret keys, database passwords or payment credentials here.
