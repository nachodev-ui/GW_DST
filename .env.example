# Copy to apps/mobile/.env. All EXPO_PUBLIC_* values are embedded in the app.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Future Project promotion only, after its SQL v2 contract is deployed. Not authorization.
# Gasway Test enables the admin workspace automatically; Project stays disabled by default.
EXPO_PUBLIC_ADMIN_DOCUMENT_WORKSPACE_ENABLED=false
# Future native build configuration. Expo Go does not require these own keys.
# Restrict each Google Maps key to its app/SDK (Android package+SHA-1 / iOS bundle).
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
# Never put service_role, secret keys, database passwords or payment credentials here.
# GOOGLE_DIRECTIONS_API_KEY belongs only in Supabase Edge Function secrets, never here.
