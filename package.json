{
  "name": "gasway",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0 || >=27.0.0"
  },
  "scripts": {
    "start": "npm run start --workspace @gasway/mobile",
    "web": "npm run web --workspace @gasway/mobile",
    "android": "npm run android --workspace @gasway/mobile",
    "ios": "npm run ios --workspace @gasway/mobile",
    "typecheck": "npm run typecheck --workspace @gasway/mobile",
    "lint": "npm run lint --workspace @gasway/mobile",
    "test": "node scripts/test-offline.cjs",
    "test:coverage": "c8 node scripts/test-offline.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:lint": "supabase db lint --local",
    "db:test": "supabase test db",
    "db:test:cloud": "node scripts/run-sql-tests.cjs",
    "db:test:concurrency": "node scripts/run-concurrency-tests.cjs",
    "db:test:prepare": "node scripts/prepare-test-cloud.cjs",
    "db:test:list": "node scripts/run-sql-tests.cjs --list",
    "db:types": "node scripts/generate-db-types.mjs"
  },
  "devDependencies": {
    "c8": "12.0.0",
    "prettier": "3.9.10",
    "supabase": "2.121.0"
  }
}
